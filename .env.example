# =============================================================================
# MediCitas — environment template.
#   cp .env.example .env
# The values below are LOCAL DEVELOPMENT placeholders so that the stack starts
# without manual steps. They are not secrets: change them in .env for any shared
# environment. .env is ignored by Git; never commit real credentials.
# =============================================================================

# --- PostgreSQL superuser (used only by db-bootstrap) -------------------------
POSTGRES_USER=medicitas_superuser
POSTGRES_PASSWORD=dev-only-superuser-pw
POSTGRES_HOST_PORT=5432

# --- Per-service database roles (ADR-0009) ------------------------------------
# *_OWNER: Flyway migrations/seeds only. *_APP: service runtime connection.
TM_DB_OWNER_PASSWORD=dev-only-tm-owner-pw
TM_DB_APP_PASSWORD=dev-only-tm-app-pw
ONB_DB_OWNER_PASSWORD=dev-only-onb-owner-pw
ONB_DB_APP_PASSWORD=dev-only-onb-app-pw
UM_DB_OWNER_PASSWORD=dev-only-um-owner-pw
UM_DB_APP_PASSWORD=dev-only-um-app-pw
UMO_DB_OWNER_PASSWORD=dev-only-umo-owner-pw
UMO_DB_APP_PASSWORD=dev-only-umo-app-pw
CAT_DB_OWNER_PASSWORD=dev-only-cat-owner-pw
CAT_DB_APP_PASSWORD=dev-only-cat-app-pw
SCH_DB_OWNER_PASSWORD=dev-only-sch-owner-pw
SCH_DB_APP_PASSWORD=dev-only-sch-app-pw
AO_DB_OWNER_PASSWORD=dev-only-ao-owner-pw
AO_DB_APP_PASSWORD=dev-only-ao-app-pw
# Shared by the *_readonly and *_bench_norls evidence roles (tests, EXPLAIN, module 2 comparison).
DB_EVIDENCE_PASSWORD=dev-only-evidence-pw

# --- RabbitMQ (ADR-0003) ---------------------------------------------------------
# Administrative user: used only by the one-shot topology bootstrap and for operations.
RABBITMQ_ADMIN_USER=medicitas_broker_admin
RABBITMQ_ADMIN_PASSWORD=dev-only-broker-admin-pw
RABBITMQ_VHOST=medicitas
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
# One broker identity per service, least privilege (users svc_*).
RABBITMQ_TM_PASSWORD=dev-only-mq-tm-pw
RABBITMQ_ONB_PASSWORD=dev-only-mq-onb-pw
RABBITMQ_UM_PASSWORD=dev-only-mq-um-pw
RABBITMQ_UMO_PASSWORD=dev-only-mq-umo-pw
RABBITMQ_CAT_PASSWORD=dev-only-mq-cat-pw
RABBITMQ_SCH_PASSWORD=dev-only-mq-sch-pw
RABBITMQ_AO_PASSWORD=dev-only-mq-ao-pw

# --- Redis (ADR-0008, cache only) ------------------------------------------------
REDIS_HOST_PORT=6379
REDIS_SCHEDULER_PASSWORD=dev-only-redis-scheduler-pw
REDIS_HEALTHCHECK_PASSWORD=dev-only-redis-health-pw

# --- Keycloak (ADR-0005) ---------------------------------------------------------
KEYCLOAK_HOST_PORT=8080
# Public issuer base URL written into tokens (must be the URL clients use to obtain tokens).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Temporary bootstrap administrator of the master realm (operations only).
KEYCLOAK_ADMIN_USERNAME=medicitas-kc-admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-kc-admin-pw
# Injected into the realm import (realm-medicitas.json placeholders).
MEDICITAS_PROVISIONER_CLIENT_SECRET=dev-only-provisioner-secret-change-me
MEDICITAS_DEMO_USER_PASSWORD=dev-only-Demo-Pass-2026
MEDICITAS_PLATFORM_ADMIN_PASSWORD=dev-only-Platform-Pass-2026

# --- Domain services (Stage 5) ---------------------------------------------------
# The API gateway is the only service published on the host (http://localhost:8000/api/v1/...).
GATEWAY_HOST_PORT=8000
# pino level of every service container (fatal|error|warn|info|debug|trace|silent).
LOG_LEVEL=info
# Availability cache of the scheduler (ADR-0008). false = always read PostgreSQL (X-Cache: BYPASS).
AVAILABILITY_CACHE_ENABLED=true
AVAILABILITY_CACHE_TTL_SECONDS=300

# --- Seed data -----------------------------------------------------------------
# true: load the three demo clinics (required for the evaluation and the demo).
SEED_DEMO_DATA=true
