# =============================================================================
# MediCitas — environment template.
#   cp .env.example .env
# The values below are LOCAL DEVELOPMENT placeholders so that the stack starts
# without manual steps. They are not secrets: change them in .env for any shared
# environment. .env is ignored by Git; never commit real credentials.
# =============================================================================

# --- PostgreSQL superuser (used only by db-bootstrap) -------------------------
POSTGRES_USER=medicitas_superuser
POSTGRES_PASSWORD=dev-only-superuser-pw
POSTGRES_HOST_PORT=5432

# --- Per-service database roles (ADR-0009) ------------------------------------
# *_OWNER: Flyway migrations/seeds only. *_APP: service runtime connection.
TM_DB_OWNER_PASSWORD=dev-only-tm-owner-pw
TM_DB_APP_PASSWORD=dev-only-tm-app-pw
ONB_DB_OWNER_PASSWORD=dev-only-onb-owner-pw
ONB_DB_APP_PASSWORD=dev-only-onb-app-pw
UM_DB_OWNER_PASSWORD=dev-only-um-owner-pw
UM_DB_APP_PASSWORD=dev-only-um-app-pw
UMO_DB_OWNER_PASSWORD=dev-only-umo-owner-pw
UMO_DB_APP_PASSWORD=dev-only-umo-app-pw
CAT_DB_OWNER_PASSWORD=dev-only-cat-owner-pw
CAT_DB_APP_PASSWORD=dev-only-cat-app-pw
SCH_DB_OWNER_PASSWORD=dev-only-sch-owner-pw
SCH_DB_APP_PASSWORD=dev-only-sch-app-pw
AO_DB_OWNER_PASSWORD=dev-only-ao-owner-pw
AO_DB_APP_PASSWORD=dev-only-ao-app-pw
# Shared by the *_readonly and *_bench_norls evidence roles (tests, EXPLAIN, module 2 comparison).
DB_EVIDENCE_PASSWORD=dev-only-evidence-pw

# --- Seed data -----------------------------------------------------------------
# true: load the three demo clinics (required for the evaluation and the demo).
SEED_DEMO_DATA=true
