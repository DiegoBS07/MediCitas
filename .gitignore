# Dependencies (the rubric penalizes committing installed dependency folders)
node_modules/
.npm/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Local environment and secrets (only the example file is versioned)
.env
.env.*
!.env.example

