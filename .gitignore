coverage/
.vitest/
tests/**/reports/
*.lcov

# Logs
logs/
*.log
npm-debug.log*

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Excalidraw editor backups
*.excalidraw.bak

# docs
docs/

