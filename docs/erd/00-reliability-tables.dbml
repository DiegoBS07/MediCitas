// Reliability tables present, identical, in every service database
// (medicitas_tenant, medicitas_onboarding, medicitas_user, medicitas_user_orchestrator,
//  medicitas_catalog, medicitas_scheduler, medicitas_appointment_orchestrator).
// They have no foreign keys; each one is used on its own.

Project medicitas_reliability {
  database_type: 'PostgreSQL'
  Note: 'Transactional outbox, consumer inbox and HTTP idempotency records. Forced Row-Level Security by tenant_id.'
}

Table outbox_messages {
  id uuid [pk, note: 'Equals envelope.messageId']
  tenant_id uuid [note: 'NULL only for control-plane platform messages']
  exchange text [not null, note: 'medicitas.commands | medicitas.queries | medicitas.replies | medicitas.domain-events']
  routing_key text [not null]
  message_type text [not null]
  envelope jsonb [not null, note: 'Complete versioned envelope as published']
  created_at timestamptz [not null, default: `clock_timestamp()`]
  available_at timestamptz [not null, default: `clock_timestamp()`, note: 'Earliest publish time (back-off)']
  published_at timestamptz [note: 'Set after the publisher confirm; NULL = pending']
  attempts integer [not null, default: 0]
  last_error text

  Indexes {
    available_at [name: 'outbox_messages_pending_idx', note: 'Partial: unpublished rows only']
  }

  Note: 'Messages inserted in the same transaction as the state change they announce; published by the relay.'
}

Table inbox_messages {
  consumer text [not null, note: 'Logical consumer (queue name)']
  message_id uuid [not null, note: 'Envelope messageId of the processed message']
  tenant_id uuid
  message_type text [not null]
  received_at timestamptz [not null, default: `clock_timestamp()`]
  reply_envelope jsonb [note: 'Reply re-published verbatim on duplicate delivery']

  Indexes {
    (consumer, message_id) [pk]
    received_at [name: 'inbox_messages_received_at_idx']
  }

  Note: 'Consumer de-duplication: one row per consumer and messageId, inserted in the same transaction as the effects.'
}

Table idempotency_records {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [note: 'Caller tenant, or NULL for platform-scoped requests']
  http_method text [not null, note: 'POST | PUT | PATCH | DELETE']
  route_template text [not null]
  idempotency_key text [not null]
  request_hash text [not null, note: 'SHA-256 of the canonical JSON body']
  status text [not null, default: 'in_progress', note: 'in_progress | completed']
  operation_id uuid
  response_status integer
  response_body jsonb
  created_at timestamptz [not null, default: `clock_timestamp()`]
  expires_at timestamptz [not null, default: `clock_timestamp() + interval '24 hours'`]

  Indexes {
    (tenant_id, http_method, route_template, idempotency_key) [unique, name: 'idempotency_records_scope_unique']
    expires_at [name: 'idempotency_records_expires_at_idx']
  }

  Note: 'Idempotency-Key records: same key and body replays the stored response; same key with a different body is rejected. Retained 24 h.'
}
