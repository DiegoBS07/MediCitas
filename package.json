{
  "name": "medicitas",
  "version": "0.1.0",
  "private": true,
  "description": "MediCitas — multi-tenant SaaS for medical appointments (backend and data platform).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "shared-plane/kernel",
    "shared-plane/observability",
    "shared-plane/identity",
    "shared-plane/messaging",
    "shared-plane/cache",
    "shared-plane/runtime",
    "control-plane/tenant-management",
    "application-plane/user-management",
    "application-plane/catalog-service-management",
    "application-plane/scheduler-management",
    "application-plane/appointment-orchestrator",
    "application-plane/user-management-orchestrator",
    "control-plane/onboarding-orchestrator",
    "application-plane/api-gateway"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "clean": "tsc -b --clean",
    "test": "npm run test:unit && npm run test:integration && npm run test:acceptance",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:acceptance": "vitest run --project acceptance",
    "check:no-any": "node scripts/check-no-any.mjs",
    "smoke": "node scripts/smoke-compose.mjs",
    "stack:up": "docker compose up -d --build --wait",
    "stack:services:stop": "docker compose stop api-gateway tenant-management onboarding-orchestrator user-management user-management-orchestrator catalog-service-management scheduler-management appointment-orchestrator",
    "bench:cache": "node scripts/bench-availability.mjs",
    "bench:tenancy": "node database/tools/bench-multitenancy.mjs",
    "evidence:explain": "node database/tools/explain-app-queries.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
