{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@medicitas/kernel": ["./shared-plane/kernel/src/index.ts"],
      "@medicitas/observability": ["./shared-plane/observability/src/index.ts"],
      "@medicitas/identity": ["./shared-plane/identity/src/index.ts"],
      "@medicitas/messaging": ["./shared-plane/messaging/src/index.ts"],
      "@medicitas/cache": ["./shared-plane/cache/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "shared-plane/*/tests/**/*.ts", "vitest.config.ts"]
}
